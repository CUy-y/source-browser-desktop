<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_background"
    android:orientation="vertical">
    <TextView android:id="@+id/shop_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/shop_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/text_secondary" android:textSize="12sp" />
    <TextView android:id="@+id/shop_error" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/danger" android:textSize="12sp" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:gravity="end" android:orientation="horizontal">
        <Button android:id="@+id/shop_refresh" android:layout_width="wrap_content" android:layout_height="38dp" android:text="刷新" android:textAllCaps="false" />
        <Button android:id="@+id/shop_open" android:layout_width="wrap_content" android:layout_height="38dp" android:text="打开" android:textAllCaps="false" />
        <Button android:id="@+id/shop_remove" android:layout_width="wrap_content" android:layout_height="38dp" android:text="移除" android:textAllCaps="false" android:textColor="@color/danger" />
    </LinearLayout>
</LinearLayout>
