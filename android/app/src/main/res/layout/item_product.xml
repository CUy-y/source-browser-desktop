<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_background"
    android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/product_source" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@color/blue_100" android:paddingHorizontal="7dp" android:paddingVertical="3dp" android:textColor="@color/blue_900" android:textSize="11sp" android:textStyle="bold" />
        <TextView android:id="@+id/product_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:ellipsize="end" android:maxLines="2" android:textColor="@color/blue_700" android:textSize="15sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:id="@+id/product_shop" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/text_secondary" android:textSize="12sp" />
    <TextView android:id="@+id/product_prices" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_primary" android:textSize="14sp" android:textStyle="bold" />
    <TextView android:id="@+id/product_meta" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textColor="@color/text_secondary" android:textSize="12sp" />
    <Button android:id="@+id/product_detail" android:layout_width="wrap_content" android:layout_height="38dp" android:layout_gravity="end" android:layout_marginTop="5dp" android:text="默认浏览器打开详情" android:textAllCaps="false" android:textColor="@color/blue_700" />
</LinearLayout>
